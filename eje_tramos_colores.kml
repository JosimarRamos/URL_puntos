<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Eje_Por_Tramos</name>
    <description>Eje diferenciado por tramos con colores especificos</description>

    <!-- ESTILOS DE COLOR POR TRAMO (Formato AABBGGRR) -->
    <!-- Tramo 2: Rojo brillante -->
    <Style id="estiloT02">
      <LineStyle>
        <color>ff0000ff</color>
        <width>4</width>
      </LineStyle>
    </Style>

    <!-- Tramo 3: Naranja -->
    <Style id="estiloT03">
      <LineStyle>
        <color>ff0080ff</color>
        <width>4</width>
      </LineStyle>
    </Style>

    <!-- PBII (Puente Belice II): Amarillo -->
    <Style id="estiloPBII">
      <LineStyle>
        <color>ff00ffff</color>
        <width>5</width>
      </LineStyle>
    </Style>

    <!-- Tramo 4: Verde -->
    <Style id="estiloT04">
      <LineStyle>
        <color>ff00bb00</color>
        <width>4</width>
      </LineStyle>
    </Style>

    <!-- Tramo 5: Cian / Celeste -->
    <Style id="estiloT05">
      <LineStyle>
        <color>ffffff00</color>
        <width>4</width>
      </LineStyle>
    </Style>

    <!-- Tramo 6: Magenta / Violeta -->
    <Style id="estiloT06">
      <LineStyle>
